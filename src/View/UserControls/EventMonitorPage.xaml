<UserControl x:Class="PilotLookUp.View.UserControls.EventMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PilotLookUp.View.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Экспорт словарей ресурсов Pilot -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\Resources\StyleDictionary.xaml" />
                <ResourceDictionary Source="..\..\Resources\VMMap.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{DynamicResource HoverBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Категория: "
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="5,0,0,0"
                       Foreground="{DynamicResource NormalForeground}" />

            <ComboBox Grid.Column="1"
                      Width="100"
                      VerticalAlignment="Center"
                      Margin="5,0,10,0"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}" />

            <TextBox Grid.Column="2"
                     Style="{StaticResource TextBox_Style}"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"
                     Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Фильтр по тексту (вид, заголовок, пользователь, тип, сообщение)" />

            <TextBlock Grid.Column="3"
                       Text="{Binding EventsCounter}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource NormalForeground}" />

            <Button Grid.Column="4"
                    Content="Очистить"
                    Command="{Binding ClearCommand}"
                    Padding="10,3"
                    Margin="0,5,5,5" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding EventsView}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      SelectedItem="{Binding SelectedEvent}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время"
                                        Binding="{Binding Time, Mode=OneWay}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="Вид"
                                        Binding="{Binding Kind, Mode=OneWay}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="Заголовок"
                                        Binding="{Binding Title, Mode=OneWay}"
                                        Width="*" />
                    <DataGridTextColumn Header="Пользователь"
                                        Binding="{Binding UserName, Mode=OneWay}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="Тип"
                                        Binding="{Binding TypeTitle, Mode=OneWay}"
                                        Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource HoverBackground}" />

            <Grid Grid.Column="2"
                  Visibility="{Binding DetailVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" DataContext="{Binding SelectedEvent}">
                        <TextBlock Text="Вид события" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding Kind}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="Заголовок" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding Title}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="Дата и время" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding FullTime}" Margin="0,0,0,8" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="Пользователь" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding UserInfo}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="Тип объекта" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding TypeInfo}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="ObjectId" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBox Text="{Binding ObjectId, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="NotificationName" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding NotificationName}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="Сообщение" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding Message}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NormalForeground}" />

                        <TextBlock Text="ChangesetId" FontWeight="Bold" Foreground="{DynamicResource NormalForeground}" />
                        <TextBlock Text="{Binding ChangesetId}" Margin="0,0,0,8" Foreground="{DynamicResource NormalForeground}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,5,5">
                    <Button ToolTip="Перейти к объекту в Pilot"
                            Style="{StaticResource CastomImageButton}"
                            Command="{Binding GoToCommand}"
                            Content="..\Resources\UI\goTo.png" />
                    <Button ToolTip="Открыть в LookUp"
                            Style="{StaticResource CastomImageButton}"
                            Command="{Binding OpenLookUpCommand}"
                            Content="..\Resources\UI\lookUpView.png" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
